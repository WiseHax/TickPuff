{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TickPuff",
  "version": "0.4.0",
  "identifier": "com.tickpuff.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TickPuff",
        "width": 1024,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Ambient desktop clock with a living companion",
    "longDescription": "TickPuff is a lightweight ambient desktop clock with themed worlds, a roaming 3D companion and optional focus, task and developer widgets.",
    "copyright": "Copyright (c) 2026 TickPuff contributors",
    "license": "MIT",
    "homepage": "https://github.com/WiseHax/TickPuff",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RDlGRDY0Q0JFNUIzRjIKUldUeXMrWExaUDNaZFdOMW1zakRRRHRVM3c1aG5TLytvTVdTYzNqWHhOc1Z1N3NyMjVpblBJaW0K",
      "endpoints": ["https://github.com/WiseHax/TickPuff/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
